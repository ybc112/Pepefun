{
  "name": "pepe-launch-arena-bsc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "hardhat:compile": "hardhat compile",
    "deploy:factory:bsc": "hardhat run scripts/deploy-factory.cjs --network bsc",
    "deploy:factory:testnet": "hardhat run scripts/deploy-factory.cjs --network bscTestnet",
    "verify:factory:bsc": "hardhat verify --network bsc",
    "verify:factory:testnet": "hardhat verify --network bscTestnet",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name pepefun"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "vite": "^5.4.11"
  }
}
